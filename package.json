{
  "name": "concord-desktop",
  "version": "1.0.0",
  "description": "Concord - Plataforma privada de comunicação por texto, voz, vídeo e compartilhamento de tela (WebRTC P2P Mesh + Electron & Web)",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "test": "node --test tests/test-all-features.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "desktop": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win --x64"
  },
  "keywords": [
    "concord",
    "webrtc",
    "voice-chat",
    "screen-share",
    "electron"
  ],
  "author": "Ramom Souza",
  "license": "PRIVATE",
  "dependencies": {
    "@prisma/client": "^6.4.1"
  },
  "build": {
    "appId": "com.ramom.concord",
    "productName": "Concord",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "server/**/*",
      "concord.png",
      "logo-concord.png",
      "Gemini_Generated_Image_nh6wb4nh6wb4nh6w.jpg",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "logo-concord.png"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "prisma": "^6.4.1"
  }
}
