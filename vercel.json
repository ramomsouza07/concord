{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"Concord: sem dependencias de runtime\"",
  "buildCommand": "echo \"Concord: sem etapa de build\"",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{server/**,concord.png,logo-concord.png,Gemini_Generated_Image_nh6wb4nh6wb4nh6w.jpg}",
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/assets/:path*", "destination": "/api/index" },
    { "source": "/uploads/:path*", "destination": "/api/index" },
    { "source": "/favicon.ico", "destination": "/api/index" }
  ]
}
